{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/urban-vault/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/urban-vault/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/urban-vault",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "authx-service": {
      "type": "application",
      "root": "apps/authx-service",
      "entryFile": "main",
      "sourceRoot": "apps/authx-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/authx-service/tsconfig.app.json"
      }
    },
    "docmanage-service": {
      "type": "application",
      "root": "apps/docmanage-service",
      "entryFile": "main",
      "sourceRoot": "apps/docmanage-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/docmanage-service/tsconfig.app.json"
      }
    },
    "urban-vault": {
      "type": "application",
      "root": "apps/urban-vault",
      "entryFile": "main",
      "sourceRoot": "apps/urban-vault/src",
      "compilerOptions": {
        "tsConfigPath": "apps/urban-vault/tsconfig.app.json"
      }
    }
  }
}